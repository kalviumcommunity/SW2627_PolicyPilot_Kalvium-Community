# PolicyPilot RAG Assistant Environment Variables

# LLM API Base URL (e.g. https://api.openai.com/v1 or custom OpenAI-compatible endpoint)
API_BASE_URL=

# LLM API Key (Keep secret! Do not commit real credentials or keys to Git)
API_KEY=

# Primary Chat Model (e.g. qwen/qwen3.6-27b or gpt-4o-mini)
CHAT_MODEL=qwen/qwen3.6-27b

# Primary Embedding Model (e.g. text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small

# Vector Database Persistence Directory (Defaults to outputs/chroma_db)
CHROMA_PERSIST_DIR=outputs/chroma_db

# Server Port (Defaults to 8000)
PORT=8000
